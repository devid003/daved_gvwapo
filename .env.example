# ===== Discord =====
DISCORD_TOKEN=
# Your own Discord user ID (owners skip member approval). Comma-separate several.
OWNER_IDS=
# Servers that are always approved (comma separated). You can add more on the dashboard.
ALLOWED_GUILD_IDS=

# ===== Dashboard =====
# Choose a NEW strong password. Never put real values in this example file.
ADMIN_PASSWORD=
# Any long random text. On Render this can be generated for you.
SECRET_KEY=
DISPLAY_TZ=Asia/Manila

# ===== Image generator =====
IMAGE_PROVIDER=pollinations
POLLINATIONS_TOKEN=
OPENAI_API_KEY=
MIN_INTERVAL_MINUTES=10
# Max pictures per member per 24h (0 = unlimited)
DAILY_LIMIT_PER_USER=0

# ===== Database (leave empty locally; REQUIRED on Render) =====
DATABASE_URL=

# ===== Upload-time reports + USD/PHP (optional; you can set channels on the dashboard) =====
CHANNEL_ID=
YT_CHANNEL_ID=
FB_CHANNEL_ID=
SCHEDULE_CHANNEL_ID=
FX_CHANNEL_ID=
# Hour (US Eastern) for the daily "Today's best upload times" post. 0 = 12:00 AM ET
SCHEDULE_HOUR_ET=0
# First-run defaults (change later on the dashboard)
INTERVAL_MINUTES=10
FX_INTERVAL_MINUTES=60
